{
    "preset": "laravel",
    "rules": {
        "control_structure_braces": true,
        "control_structure_continuation_position": {
            "position": "next_line"
        },
        "braces_position": {
            "control_structures_opening_brace": "next_line_unless_newline_at_signature_end"
        },
        "not_operator_with_successor_space": true,
        "array_syntax": {
            "syntax": "short"
        }
    },
    "exclude": ["lang"]
}
